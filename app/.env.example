# ============================================================
#  SLA Monitoring Agent settings
#  Copy this file to .env (setup_ai_key.bat does it for you).
#  .env is private: it is in .gitignore and is never uploaded.
# ============================================================

# ---- LLM (optional). Without a key the agent runs in OFFLINE mode (rule-based).
# groq   = free, fast. Key: https://console.groq.com/keys        (default model llama-3.3-70b-versatile)
# gemini = free tier. Key: https://aistudio.google.com/apikey    (default model gemini-2.5-flash)
# openrouter = free models. Key: https://openrouter.ai/keys
# ollama = runs on your PC, no key. Install https://ollama.com then: ollama pull qwen2.5:7b
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=

# ---- Daily report e-mail (optional). Gmail: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it below (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ---- Chat alert (optional): Slack / Microsoft Teams / Discord / Google Chat incoming-webhook URL
WEBHOOK_URL=

# ---- Report window in days (default 30)
REPORT_WINDOW_DAYS=30
