model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DataFolder", "FactTickets", "DimPriority", "DimTeam", "DimAgent", "DimCategory", "DimDate", "DimSnapshot", "_Measures"]

ref table FactTickets
ref table DimPriority
ref table DimTeam
ref table DimAgent
ref table DimCategory
ref table DimDate
ref table DimSnapshot
ref table _Measures

ref cultureInfo en-US

