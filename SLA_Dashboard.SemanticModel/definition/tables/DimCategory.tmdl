		sourceColumn: SubCategory

		annotation SummarizationSetBy = User

	partition DimCategory = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "DimCategory.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"CategoryKey", Int64.Type}, {"Category", type text}, {"SubCategory", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

