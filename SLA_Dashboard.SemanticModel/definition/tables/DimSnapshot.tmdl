table DimSnapshot
	lineageTag: aeebd297-fea2-5cb1-af42-ec58c5595fa1

	column AsOfDateTime
		dataType: dateTime
		formatString: General Date
		lineageTag: 50dbb5b8-4bce-5023-9bb0-54f093b51cc1
		summarizeBy: none
		sourceColumn: AsOfDateTime

		annotation SummarizationSetBy = User

	partition DimSnapshot = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "DimSnapshot.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"AsOfDateTime", type datetime}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

